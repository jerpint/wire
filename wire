#!/usr/bin/env python3
"""wire — let CLI coding agents talk to each other.

One file. Standard library only. No config, no daemon, no registry.

tmux is the database: tmux sessions are the address book, and a walk of each
pane's process tree says which sessions are live agents and which harness each
one runs. wire therefore ADOPTS agents you started by hand — it never asks to
be the thing that launches them.

Usable three ways:
  - as a binary   : put this file on PATH, `wire list`
  - as a library  : `import wire` (needs a .py name — see README)
  - as a skill    : SKILL.md next to this file teaches an agent the verbs

Verbs:
  wire list                      which agents are running, and on what
  wire send <target> "message"   deliver a message, with a return address
  wire spawn <harness> "seed"    start an agent and brief it
  wire read <target> [-n LINES]  read what an agent currently shows

THE ENVELOPE — the one design rule that matters:
  A delivered message NEVER contains a runnable command. It carries a plain
  `reply-to` address as data; the receiving agent learns the reply verb from
  the skill, not from the message body. Embedding a literal command invites an
  auto-approving agent to execute the message instead of reading it — which we
  have watched happen for real.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import time

__version__ = "0.1.0"

TMUX_TIMEOUT = 10
_PREFIX = "wire"


# ---------------------------------------------------------------------------
# Harness table — everything that describes an AGENT lives here and nowhere
# else. Adding a harness should be adding one entry.
#
# Every quirk below was found the hard way against a live TUI. They are not
# theoretical.
# ---------------------------------------------------------------------------

HARNESSES = {
    "claude": {
        "label": "Claude Code",
        "binary": "claude",
        # comm names that mean "the agent is running" in a process tree
        "process_names": {"claude"},
        # Claude's TUI is paste-aware: a \n inside a paste is a literal newline,
        # so a trailing Enter must be a SEPARATE keystroke. It accepts that
        # Enter immediately.
        "paste_settle": 0.0,
        # Paste-aware TUIs render multi-line pastes correctly.
        "flatten_paste_newlines": False,
        "leading_slash_opens_palette": False,
        "skill_invoke": "/{name}",
        "yolo_flag": "--dangerously-skip-permissions",
        "model_flag": "--model",
    },
    "codex": {
        "label": "Codex",
        "binary": "codex",
        "process_names": {"codex"},
        # Codex folds an Enter arriving right after a paste INTO the paste — the
        # message strands in the composer. It needs a settle before Enter.
        "paste_settle": 0.5,
        "flatten_paste_newlines": False,
        "leading_slash_opens_palette": False,
        # Codex's native mention feature; `$name` only ever worked by the model
        # choosing to read the file itself.
        "skill_invoke": "@{name}",
        "yolo_flag": "--dangerously-bypass-approvals-and-sandbox",
        "model_flag": "-m",
    },
    "opencode": {
        "label": "opencode",
        "binary": "opencode",
        "process_names": {"opencode"},
        "paste_settle": 0.3,
        # opencode's TUI is NOT paste-aware — it DROPS newlines from a pasted
        # message entirely, joining lines with no separator at all. Flattening
        # to spaces is what keeps word boundaries alive.
        "flatten_paste_newlines": True,
        # A message starting with "/" opens opencode's command palette and never
        # submits ("No matching items"). A leading space makes it a literal
        # message, and opencode still resolves the skill natively.
        "leading_slash_opens_palette": True,
        "skill_invoke": "/{name}",
        "yolo_flag": "--auto",
        "model_flag": "--model",
    },
}

def harness_names() -> list[str]:
    return list(HARNESSES)


def get_harness(name: str) -> dict:
    try:
        return HARNESSES[name]
    except KeyError:
        raise ValueError(
            f"unknown harness {name!r}; known: {', '.join(HARNESSES)}"
        ) from None


# ---------------------------------------------------------------------------
# tmux + process discovery
# ---------------------------------------------------------------------------

class WireError(Exception):
    """Anything wire can't do — missing tmux, dead target, unknown harness."""


def _run(cmd: list[str], check: bool = True) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(
            cmd, capture_output=True, text=True, check=check, timeout=TMUX_TIMEOUT
        )
    except FileNotFoundError:
        raise WireError(f"{cmd[0]} not found on PATH") from None
    except subprocess.TimeoutExpired:
        raise WireError(f"{cmd[0]} timed out after {TMUX_TIMEOUT}s") from None


def tmux_sessions() -> list[str]:
    """Every live tmux session name."""
    try:
        out = _run(["tmux", "list-sessions", "-F", "#{session_name}"]).stdout
    except WireError:
        raise
    except subprocess.CalledProcessError:
        return []  # no server running == no sessions
    return [s for s in out.strip().split("\n") if s]


def _process_table() -> tuple[dict[str, list[str]], dict[str, str]]:
    """Return (pid -> [child pids], pid -> comm).

    Portable across GNU/procps and BSD/macOS ps. BSD has no --no-headers and
    reports `comm` as a full path, so the header is dropped by hand and the
    basename taken. This matters: wire is meant to run on a laptop, and that
    laptop is often a Mac.
    """
    proc = subprocess.run(
        ["ps", "-eo", "pid,ppid,comm"], capture_output=True, text=True
    )
    children: dict[str, list[str]] = {}
    comms: dict[str, str] = {}
    for line in proc.stdout.strip().split("\n"):
        parts = line.split(None, 2)
        if len(parts) < 3:
            continue
        pid, ppid, comm = parts
        if not pid.isdigit() or not ppid.isdigit():
            continue  # the header row
        children.setdefault(ppid, []).append(pid)
        comms[pid] = os.path.basename(comm.strip())
    return children, comms


# Field order matters. pane_id ("%12"), pane_pid (digits) and wire_name
# (sanitised on the way in) can never contain the separator; session_name can
# contain anything at all, so it goes LAST and is split off with maxsplit.
# ":" is belt and braces on top of that — tmux rewrites ":" to "_" in session
# names, so it cannot appear there even by accident.
_PANE_FMT = "#{pane_id}:#{pane_pid}:#{@wire_name}:#{session_name}"


def _all_panes() -> list[tuple[str, str, str, str]]:
    """[(pane_id, pane_pid, wire_name, session)] for EVERY pane on the server.

    One `list-panes -a` for the whole server, deliberately. The obvious
    alternative — walking sessions and asking for each one's panes — passes a
    session NAME as a tmux target, and tmux does not resolve a bare target the
    way you would hope: a numeric name like "1" is matched against the CURRENT
    session's windows first, so `list-panes -s -t 1` run from session 6 returns
    session 6's panes. Default tmux session names are numeric, so that
    misattributes exactly the hand-started sessions wire exists to find, and a
    message addressed to one agent gets delivered into another.

    Asking the server for everything at once sidesteps target parsing entirely,
    and costs one subprocess instead of one per session.
    """
    try:
        out = _run(["tmux", "list-panes", "-a", "-F", _PANE_FMT]).stdout
    except subprocess.CalledProcessError:
        return []  # no server running == no panes
    panes = []
    for line in out.strip().split("\n"):
        if not line:
            continue
        parts = line.split(":", 3)
        if len(parts) == 4:
            panes.append((parts[0], parts[1], parts[2], parts[3]))
    return panes


def set_wire_name(pane: str, name: str) -> None:
    """Give a pane a stable wire address, stored as a tmux pane option.

    A pane option is the only place on a pane that stays put. Panes cannot be
    renamed at all — there is no `rename-pane` — and `pane_title`, the obvious
    candidate, is continuously overwritten by the harness with whatever it is
    currently doing ("✳ Review and discuss pull request"). A user option is
    ours alone; tmux never touches it and neither does the TUI.

    Sanitised to the same character set as an envelope address, so a name can
    never contain the field separator or forge header structure.
    """
    clean = _clean_addr(name)
    if clean:
        _run(["tmux", "set", "-p", "-t", pane, "@wire_name", clean], check=False)


def _scan() -> list[dict]:
    """Every agent on the tmux server, one pane at a time.

    Walks the FULL subtree under each pane pid, not just direct children — the
    real tree is pane(bash) -> wrapper -> agent, so checking direct children
    alone always misses it.
    """
    panes = _all_panes()
    if not panes:
        return []
    children, comms = _process_table()
    by_comm = {}
    for name, entry in HARNESSES.items():
        for pname in entry["process_names"]:
            by_comm[pname] = name

    found = []
    for pane_id, pane_pid, wire_name, session in panes:
        queue = [pane_pid]
        seen: set[str] = set()
        while queue:
            cur = queue.pop()
            if cur in seen:
                continue
            seen.add(cur)
            hit = by_comm.get(comms.get(cur, ""))
            if hit:
                found.append({"session": session, "pane": pane_id,
                              "harness": hit, "label": HARNESSES[hit]["label"],
                              "name": wire_name})
                break
            queue.extend(children.get(cur, []))
    return found


def find_agents(session: str) -> list[tuple[str, str]]:
    """Every (harness, pane_id) running an agent in this session.

    A session can hold more than one — panes and windows are free, and people
    put a second agent next to the first. Returning all of them keeps that
    honest; picking the first would make the address silently mean whichever
    tmux happened to list earliest.
    """
    return [(a["harness"], a["pane"]) for a in _scan() if a["session"] == session]


def find_agent(session: str) -> tuple[str, str] | None:
    """(harness, pane_id) for the FIRST agent in this session, or None.

    Returning the PANE and not just the session matters. A session can hold
    several panes, and `tmux -t <session>` resolves to whichever pane is
    ACTIVE — not necessarily the one running the agent. Detecting an agent in
    one pane and then delivering to the session would type the message into
    whatever else happens to be focused, and a shell would run it. So the pane
    that actually holds the agent is the address.

    Walks the FULL subtree under each pane pid, not just direct children — the
    real tree is pane(bash) -> wrapper -> agent, so checking direct children
    alone always misses it.
    """
    found = find_agents(session)
    return found[0] if found else None


def detect_harness(session: str) -> str | None:
    """Which harness runs in this session, if any."""
    hit = find_agent(session)
    return hit[0] if hit else None


def agents() -> list[dict]:
    """Every agent on the tmux server, each with an unambiguous address.

    This is the whole address book. No state file is consulted, which is why
    wire works on sessions it never launched.

    Every record carries an `addr` that resolve() is guaranteed to map back to
    that same pane. Three kinds of address, in descending order of niceness:

        %57              the pane id. Always unique, always works, always ugly.
        worker-a11f3c    @wire_name, a pane option wire sets when it spawns.
        my-session       the session name — an alias, and only an address when
                         the session holds exactly one agent.

    The pane is the identity; the other two are conveniences that get withdrawn
    the moment they stop being unique. Nothing here is ever ambiguous: a name
    that two agents could answer to is not offered as an address at all.
    """
    found = _scan()
    by_name: dict[str, list[dict]] = {}
    by_session: dict[str, list[dict]] = {}
    for a in found:
        if a["name"]:
            by_name.setdefault(a["name"], []).append(a)
        by_session.setdefault(a["session"], []).append(a)

    # Mirror resolve()'s precedence exactly — name, then session, then pane —
    # so `addr` is by construction a target that resolves back to this pane.
    # Deriving it any other way invites the two to drift, and the symptom of
    # drift is an address the address book prints and resolve() then rejects.
    for a in found:
        # True when this session holds more than one agent, so the session name
        # alone is not a usable address.
        a["shared_session"] = len(by_session[a["session"]]) > 1
        if a["name"] and len(by_name[a["name"]]) == 1:
            a["addr"] = a["name"]
        elif a["session"] not in by_name and not a["shared_session"]:
            # A session name loses to a wire name of the same spelling, because
            # that is the order resolve() tries them in.
            a["addr"] = a["session"]
        else:
            a["addr"] = a["pane"]
    return found


def resolve(target: str) -> dict:
    """Resolve a target to exactly one agent record, or refuse.

    Accepts a pane id, a wire name, a session name, or a unique prefix of
    either name. Tried in that order, most specific first.

    The contract is that this never guesses. Where a target could mean two
    agents it raises and names them, because the failure it is guarding against
    is silent: a message delivered confidently into the wrong agent's pane reads
    as `delivered` to the sender and as an interruption to a stranger.
    """
    found = agents()
    # A pane id is always exact, and it is the way out of every ambiguity below.
    if target.startswith("%"):
        by_pane = [a for a in found if a["pane"] == target]
        if by_pane:
            return by_pane[0]
        raise WireError(f"no agent in pane {target}")

    for field in ("name", "session"):
        exact = [a for a in found if a[field] == target]
        if len(exact) == 1:
            return exact[0]
        if len(exact) > 1:
            panes = ", ".join(f"{a['pane']} ({a['harness']})" for a in exact)
            raise WireError(
                f"{field} {target!r} holds {len(exact)} agents — address one by "
                f"pane: {panes}"
            )

    partial = [a for a in found
               if a["session"].startswith(target)
               or (a["name"] and a["name"].startswith(target))]
    if len(partial) == 1:
        return partial[0]
    if len(partial) > 1:
        names = ", ".join(a["addr"] for a in partial)
        raise WireError(f"{target!r} is ambiguous: {names}")
    if not found:
        raise WireError("no agents running. `wire list` to check.")
    names = ", ".join(a["addr"] for a in found)
    raise WireError(f"no agent named {target!r}. running: {names}")


# ---------------------------------------------------------------------------
# The envelope
# ---------------------------------------------------------------------------

def whoami() -> str:
    """This agent's own address, if it is running inside one.

    Holds one invariant, which is the whole point of the address scheme:

        resolve(whoami()) is me

    So this returns the same `addr` the address book advertises, and never a
    name the sender could not be reached at. The old answer — the enclosing
    session name — broke the invariant for every agent sharing a session with
    another: four agents in one session all claimed `reply-to: 0`, and `0` is
    precisely the target resolve() refuses as ambiguous. The envelope exists to
    make a reply possible, so handing back an unreplyable address defeats it.

    $TMUX_PANE, not `display-message`: tmux sets it per pane, so it is correct
    from a background pane. `display-message` reports whichever pane is ACTIVE
    in the session, which is a different pane whenever the agent is not the one
    on screen.

    WIRE_FROM overrides everything, for callers that know better.
    """
    override = os.environ.get("WIRE_FROM")
    if override:
        return override
    pane = os.environ.get("TMUX_PANE", "")
    if not pane:
        return ""
    for a in agents():
        if a["pane"] == pane:
            return a["addr"]
    # In a pane with no recognised agent — a plain shell, say. The pane id is
    # still the truthful answer: a reply to it will fail loudly rather than
    # land somewhere else.
    return pane


def _clean_addr(addr: str) -> str:
    """Reduce an address to something that cannot forge envelope structure.

    The address is attacker-controllable (WIRE_FROM, --from), and it is written
    into the header. Left raw, a newline in it would let a sender inject extra
    header lines — a different reply-to, say — into a message the receiver
    reads as trustworthy structure.

    This makes the envelope well-formed. It does NOT make it authentic: nothing
    here proves a sender is who it claims. See the trust note in the README.

    "%" is in the keep set because a pane id is a real address — strip it and
    `%57` becomes `57`, a reply-to that resolves to nothing or, worse, to some
    unrelated session that happens to be named "57".
    """
    return re.sub(r"[^\w.@:%-]", "", addr)[:120]


def format_envelope(text: str, from_addr: str = "") -> str:
    """Wrap a message with a return address.

    Deliberately contains NO runnable command. `reply-to` is an address, and
    the skill teaches the verb. An agent running with auto-approved shell access
    will happily execute a message that looks like a command — so the message
    must not look like one.
    """
    from_addr = _clean_addr(from_addr)
    if not from_addr:
        return text
    return (
        f"[{_PREFIX} message]\n"
        f"from: {from_addr}\n"
        f"reply-to: {from_addr}\n"
        f"---\n"
        f"{text}"
    )


def _guard(text: str, harness: str) -> str:
    """Apply per-harness paste quirks to outgoing text."""
    entry = get_harness(harness)
    if entry["flatten_paste_newlines"]:
        # opencode drops newlines outright; flattening to " | " keeps the
        # envelope readable instead of jamming words together.
        text = re.sub(r"\n+", " | ", text)
    if entry["leading_slash_opens_palette"] and text.startswith("/"):
        # A leading slash strands the message in the command palette. A leading
        # space makes it a literal message, and the skill still resolves.
        text = " " + text
    return text


# ---------------------------------------------------------------------------
# Transport
# ---------------------------------------------------------------------------

def paste(target: str, text: str, harness: str) -> None:
    """Deliver text into a running agent's TUI and submit it.

    set-buffer + paste-buffer rather than send-keys -l: send-keys sends each
    character as its own keystroke and backs up the pane input buffer on long
    messages. A buffer paste lands atomically, exactly like a human paste.

    Enter is a separate keystroke afterwards, because paste-aware TUIs treat a
    \\n inside a paste as a literal newline rather than submit.
    """
    entry = get_harness(harness)
    # Buffer name is per-target AND per-call: two concurrent sends to the same
    # agent would otherwise share one buffer and clobber each other.
    buf = f"{_PREFIX}-{target.lstrip('%')}-{os.urandom(3).hex()}"
    # Scrolling a pane with the mouse silently enters copy-mode, where a paste
    # is visible but never reaches the process and Enter is eaten as a copy-mode
    # command. Cancelling first is a harmless no-op when not in a mode.
    _run(["tmux", "send-keys", "-t", target, "-X", "cancel"], check=False)
    _run(["tmux", "set-buffer", "-b", buf, text])
    _run(["tmux", "paste-buffer", "-b", buf, "-d", "-t", target])
    settle = entry["paste_settle"]
    if settle:
        time.sleep(settle)
    _run(["tmux", "send-keys", "-t", target, "Enter"])


def send(target: str, message: str, from_addr: str | None = None) -> dict:
    """Deliver a message to an agent, with a return address.

    The library entry point. Returns the resolved target.
    """
    agent = resolve(target)
    sender = whoami() if from_addr is None else from_addr
    body = format_envelope(message, sender)
    paste(agent["pane"], _guard(body, agent["harness"]), agent["harness"])
    return agent


def read(target: str, lines: int = 40) -> str:
    """Capture what an agent's pane currently shows."""
    agent = resolve(target)
    out = _run([
        "tmux", "capture-pane", "-p", "-t", agent["pane"], "-S", f"-{lines}",
    ]).stdout
    return out.rstrip()


# ---------------------------------------------------------------------------
# Spawn
# ---------------------------------------------------------------------------

def build_command(harness: str, model: str = "", yolo: bool = False) -> str:
    """The command line that starts this harness.

    Standalone this is genuinely simple: the binary off PATH, running as
    whoever is already logged in. No wrappers, no per-agent HOME, no credential
    seeding — all of that is a multi-tenant platform's problem, not this tool's.
    """
    entry = get_harness(harness)
    parts = [entry["binary"]]
    if yolo:
        parts.append(entry["yolo_flag"])
    if model:
        parts += [entry["model_flag"], model]
    # tmux runs this string through a shell, so EVERY part is quoted — not just
    # the ones containing spaces. A model name carrying `;` or a backtick would
    # otherwise be a command injection through an innocuous-looking flag.
    return " ".join(shlex.quote(p) for p in parts)


# TMUX/TMUX_PANE describe the CALLER's pane. Leaking them into a new session
# makes tools inside it think they are nested somewhere they are not.
_ENV_SKIP = {"TMUX", "TMUX_PANE"}


def _tmux_supports_session_env() -> bool:
    """`new-session -e` needs tmux 3.0+."""
    try:
        out = _run(["tmux", "-V"]).stdout
    except (WireError, subprocess.CalledProcessError):
        return False
    m = re.search(r"(\d+)\.(\d+)", out)
    if not m:
        return False
    return (int(m.group(1)), int(m.group(2))) >= (3, 0)


def _env_args(extra: dict | None = None, inherit: bool = True) -> list[str]:
    """Pass the caller's environment into the new session.

    Without this, a spawned agent inherits the tmux SERVER's environment — the
    environment whoever started the server happened to have, possibly hours ago
    and possibly a different user. That silently gives the agent the wrong HOME,
    so it looks for credentials in the wrong place and comes up logged out, or
    misses the API key sitting right there in your shell.

    Caveats worth knowing rather than hiding. These values land in the tmux
    CLIENT's argv, so they are briefly visible to anyone running ps during the
    call — shorter exposure than an `env` prefix, which keeps them visible for
    the agent's whole life, but not zero.

    More subtly, inheriting wholesale also copies IDENTITY. Anything keyed on an
    environment variable to decide who it is — and agent tooling often is — will
    believe the child is the parent. Observed for real: a spawned agent inherited
    the spawner's identity variables and attributed its replies to the spawner.

    inherit=False withholds the caller's environment, but it does NOT give the
    child a clean one: the tmux server passes its own environment to every pane
    it creates, and that environment belongs to whoever started the server —
    possibly a different user, hours ago. Measured here, a child spawned with
    inherit=False still arrived carrying the server-starter's identity. So the
    choice is between the caller's environment and the server's, not between an
    environment and none. Name what you need with --env either way.
    """
    base = dict(os.environ) if inherit else {}
    args: list[str] = []
    for key, value in {**base, **(extra or {})}.items():
        if key in _ENV_SKIP or "\n" in value:
            continue
        args += ["-e", f"{key}={value}"]
    return args


def wait_ready(session: str, harness: str, timeout: float = 60.0) -> bool:
    """Wait until the agent process is actually up in this session.

    Polling for the PROCESS rather than for a banner string is harness-agnostic
    and does not rot when a TUI redesigns its footer.
    """
    deadline = time.time() + timeout
    while time.time() < deadline:
        if detect_harness(session) == harness:
            return True
        time.sleep(0.4)
    return False


# Signatures of a modal that is waiting on a keystroke. A paste delivered into
# one of these is swallowed, or worse, answers it by accident — so wire refuses
# to paste and says why. Heuristic by nature: a TUI can always invent a new
# dialog, which is why the failure is reported rather than worked around.
_BLOCKING_PROMPTS = (
    "Enter to confirm",       # claude's trust-this-folder dialog
    "Press enter to continue",  # codex's
    "yes, continue",
    "do you trust",
    "yes, i trust",
    "(y/n)",
    "[y/n]",
)


def pane_blocked(target: str) -> str:
    """Return the modal line a pane is waiting on, or "" if it is ready.

    Claude asks whether you trust a folder the first time it runs in one, and
    codex has its own trust dialog. Both appear AFTER the process is up, so
    "the process exists" is not the same as "the TUI will accept input".
    """
    try:
        pane = _run(["tmux", "capture-pane", "-p", "-t", target, "-S", "-30"]).stdout
    except (WireError, subprocess.CalledProcessError):
        return ""
    low = pane.lower()
    for sig in _BLOCKING_PROMPTS:
        if sig.lower() in low:
            for line in pane.splitlines():
                if sig.lower() in line.lower():
                    return line.strip()
    return ""


def spawn(harness: str, seed: str = "", name: str = "", model: str = "",
          yolo: bool = False, cwd: str = "", env: dict | None = None,
          inherit_env: bool = True) -> dict:
    """Start an agent in a new detached tmux session and optionally brief it.

    The seed prompt is pasted after the TUI is up rather than passed on the
    command line: some harnesses dispatch a CLI prompt before they have finished
    resolving their model, which silently sends the message to the wrong one.
    Pasting after boot sidesteps that for every harness at once.
    """
    entry = get_harness(harness)
    session = name or f"{harness}-{os.urandom(3).hex()}"
    if session in tmux_sessions():
        raise WireError(f"tmux session {session!r} already exists")

    cmd = build_command(harness, model=model, yolo=yolo)
    tmux_cmd = ["tmux", "new-session", "-d", "-s", session]
    if cwd:
        tmux_cmd += ["-c", cwd]
    if _tmux_supports_session_env():
        tmux_cmd += _env_args(env, inherit=inherit_env)
    elif env:
        raise WireError(
            "tmux 3.0+ is required to pass environment to a new session; "
            f"this is {_run(['tmux', '-V']).stdout.strip()}"
        )
    tmux_cmd.append(cmd)
    try:
        _run(tmux_cmd)
    except subprocess.CalledProcessError as e:
        raise WireError(f"could not start tmux session: {e.stderr.strip()}") from None

    # Stamp the address onto the pane now, while the session is guaranteed to
    # hold exactly one. Done here rather than after the agent boots so it also
    # covers a seedless spawn, and so the address survives the session being
    # renamed or a second agent being opened alongside this one later.
    for pane_id, _pid, _wname, sess in _all_panes():
        if sess == session:
            set_wire_name(pane_id, session)
            break

    result = {"session": session, "harness": harness, "addr": session,
              "label": entry["label"], "briefed": False}
    if not seed:
        return result
    if not wait_ready(session, harness):
        raise WireError(
            f"session {session!r} started but no {harness} process appeared. "
            f"`tmux attach -t {session}` to see what happened."
        )
    time.sleep(1.0)  # let the TUI paint before pasting into it
    hit = find_agent(session)
    if not hit:
        raise WireError(f"session {session!r} lost its {harness} process while booting")
    pane = hit[1]
    result["pane"] = pane
    blocked = pane_blocked(pane)
    if blocked:
        result["blocked_on"] = blocked
        return result
    body = format_envelope(seed, whoami())
    paste(pane, _guard(body, harness), harness)
    result["briefed"] = True
    return result


